{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "kindle.html",
      "use": "@vercel/static"
    },
    {
      "src": "js/**",
      "use": "@vercel/static"
    },
    {
      "src": "*.JPG",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/healthz",
      "dest": "/api/healthz.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/[...path].js"
    },
    {
      "src": "/healthz",
      "dest": "/api/healthz.js"
    },
    {
      "src": "/kindle/?",
      "dest": "/kindle.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
